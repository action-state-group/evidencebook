# The Python stack verify_refusal.py runs in, apart from interop-requirements.in: the -00
# refusal verifier (agent_action_capsule.evidence_request) is agent-action-capsule 0.8.0 and
# later, and the resolved release's build_bundle.py still needs 0.6.0's emit(), so
# scripts/interop-resolved.sh runs the refusal check in its own environment.
# Locked with hashes, transitively, in interop-refusal-requirements.txt:
#   uv pip compile scripts/interop-refusal-requirements.in --generate-hashes \
#     --python-version 3.12 --python-platform x86_64-unknown-linux-gnu -o scripts/interop-refusal-requirements.txt
agent-action-capsule==0.16.0
