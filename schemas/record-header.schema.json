{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/action-state-group/evidencebook/schemas/record-header.schema.json",
  "title": "Evidence Layer record header (evidencebook wire form, v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "book_id", "seq", "record_type", "epistemic_type", "committed_at", "links"],
  "properties": {
    "v": { "const": 1 },
    "book_id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "record_type": { "type": "string", "minLength": 1 },
    "epistemic_type": { "$ref": "#/$defs/epistemicType" },
    "committed_at": { "type": "string", "format": "date-time" },
    "event_time_claim": { "type": "string", "format": "date-time" },
    "payload_commitments": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
    "retention_state": { "$ref": "#/$defs/retentionState" },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "subject_ref": { "type": "string" },
    "principal_ref": { "type": "string" },
    "counterparty_ref": { "type": "string" },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exchange_id": { "type": "string" },
        "request_digest": { "type": "string" },
        "twin_bracket_id": { "type": "string" }
      }
    },
    "statement": {}
  },
  "dependentRequired": { "payload_commitments": ["retention_state"] },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "epistemicType": {
      "description": "Closed set owned by draft-mih-agent-evidence-layer-00 (posted revision 00, https://datatracker.ietf.org/doc/draft-mih-agent-evidence-layer/), section 4.1 'Epistemic Type'; interim registry: agent-action-capsule spec/REGISTRY.md section 17.",
      "enum": [
        "observed_event",
        "system_of_record_fact",
        "producer_claim",
        "human_report",
        "semantic_judgment",
        "derived_metric",
        "adjudication",
        "obligation_reference"
      ]
    },
    "linkType": {
      "description": "Closed set owned by draft-mih-agent-evidence-layer-00 (posted revision 00, https://datatracker.ietf.org/doc/draft-mih-agent-evidence-layer/), section 5 'Typed Links'; interim registry: agent-action-capsule spec/REGISTRY.md section 18.",
      "enum": ["cites", "adjudicates", "supersedes", "acknowledges", "rebuts", "closes"]
    },
    "retentionState": {
      "description": "The five states of draft-mih-agent-evidence-layer-00 (posted revision 00, https://datatracker.ietf.org/doc/draft-mih-agent-evidence-layer/), section 6.1 'Retention States'. The draft keeps this set out of its registries.",
      "enum": ["AVAILABLE", "PARTIAL", "WITHHELD", "DELETED", "LEGAL_HOLD"]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "$ref": "#/$defs/linkType" },
        "target": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
